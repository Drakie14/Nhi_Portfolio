---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { getProjects, fig } from '../../lib/data';
import { md } from '../../lib/markdown';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: {
      project: p,
      prev: projects.length > 1 ? (projects[i - 1] ?? projects[projects.length - 1]) : undefined,
      next: projects.length > 1 ? (projects[i + 1] ?? projects[0]) : undefined,
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;

// Các phần của đồ án, đúng trình tự — chỉ hiện phần có nội dung
const parts = [
  { id: 'de-bai', title: 'Đề bài / Bối cảnh', show: !!d.brief },
  { id: 'y-tuong', title: 'Ý tưởng', show: !!d.concept },
  { id: 'qua-trinh', title: 'Quá trình', show: d.process.length > 0 },
  { id: 'ket-qua', title: 'Kết quả', show: d.results.length > 0 },
  { id: 'dieu-hoc-duoc', title: 'Điều tôi học được', show: !!d.learned },
].filter((p) => p.show);
const num = (id: string) => String(parts.findIndex((p) => p.id === id) + 1).padStart(2, '0');
const teacher = d.teacher?.show && (d.teacher.score || d.teacher.comment) ? d.teacher : undefined;
---
<Base title={d.title} description={d.summary ?? `${d.title} — ${d.subject ?? 'Đồ án'}`} progress>
  <article class="project">
    <header class="cover">
      <div class="cover-img">
        <Media
          src={d.cover}
          alt={d.title}
          key={project.id}
          ratio="16/9"
          cover
          eager
          phText="Ảnh bìa sắp ra mắt"
          sizes="100vw"
          widths={[768, 1080, 1440, 1920, 2560]}
        />
      </div>
      <div class="cover-text wrap">
        <p class="label cover-meta">
          {[d.subject, d.semester].filter(Boolean).join(' · ')}
        </p>
        <h1>{d.title}</h1>
        {d.summary && <p class="cover-sum">{d.summary}</p>}
      </div>
    </header>

    <div class="wrap body">
      <nav class="toc" aria-label="Mục lục đồ án">
        <ol>
          {parts.map((p) => (
            <li>
              <a href={`#${p.id}`}>
                <span class="label">{num(p.id)}</span> {p.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="parts">
        {d.brief && (
          <section class="part" id="de-bai">
            <h2><span class="label fig">{num('de-bai')} —</span> Đề bài / Bối cảnh</h2>
            <div class="prose lead" set:html={md(d.brief)} />
          </section>
        )}

        {d.concept && (
          <section class="part" id="y-tuong">
            <h2><span class="label fig">{num('y-tuong')} —</span> Ý tưởng</h2>
            <div class="prose" set:html={md(d.concept)} />
          </section>
        )}

        {d.process.length > 0 && (
          <section class="part part-wide" id="qua-trinh">
            <h2><span class="label fig">{num('qua-trinh')} —</span> Quá trình</h2>
            <ol class="steps">
              {d.process.map((s, k) => (
                <li class:list={['step', { 'step-flip': k % 2 === 1 }]}>
                  <div class="step-img" data-reveal>
                    <Media
                      src={s.image}
                      alt={s.caption ?? `${d.title} — bước ${k + 1}`}
                      key={`${project.id}-p${k}`}
                      ratio={s.image ? undefined : '4/3'}
                      sizes="(min-width: 900px) 55vw, 100vw"
                    />
                  </div>
                  <div class="step-text">
                    <p class="label">Bước {String(k + 1).padStart(2, '0')}</p>
                    {s.caption && <p class="step-cap">{s.caption}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {d.results.length > 0 && (
          <section class="part part-wide" id="ket-qua">
            <h2><span class="label fig">{num('ket-qua')} —</span> Kết quả</h2>
            <div class="results">
              {d.results.map((r, k) => (
                <figure data-reveal>
                  <Media
                    src={r.image}
                    alt={r.caption ?? `${d.title} — kết quả ${k + 1}`}
                    key={`${project.id}-r${k}`}
                    sizes="(min-width: 900px) 50vw, 100vw"
                  />
                  <figcaption>
                    <span class="label fig">{fig(k + 1)}</span>
                    {r.caption && <span>{r.caption}</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {d.learned && (
          <section class="part" id="dieu-hoc-duoc">
            <h2><span class="label fig">{num('dieu-hoc-duoc')} —</span> Điều tôi học được</h2>
            <div class="prose lead" set:html={md(d.learned)} />
          </section>
        )}

        {teacher && (
          <aside class="teacher" aria-label="Nhận xét của giảng viên">
            <p class="label">Nhận xét của giảng viên</p>
            {teacher.comment && <blockquote>{teacher.comment}</blockquote>}
            {teacher.score && (
              <p class="score">
                <span class="label">Điểm</span> <span class="score-n">{teacher.score}</span>
              </p>
            )}
          </aside>
        )}
      </div>
    </div>

    {
      prev && next && (
        <nav class="wrap pager" aria-label="Đồ án khác">
          <a href={`/do-an/${prev.id}/`} class="pg">
            <span class="label">Đồ án trước</span>
            <span class="pg-title">{prev.data.title}</span>
          </a>
          <a href={`/do-an/${next.id}/`} class="pg pg-next">
            <span class="label">Đồ án sau</span>
            <span class="pg-title">{next.data.title}</span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  /* ---------- Ảnh bìa toàn màn hình ---------- */
  .cover {
    position: relative;
    height: calc(100svh - var(--nav-h));
    min-height: 480px;
    display: grid;
    align-items: end;
    overflow: hidden;
  }
  .cover-img {
    position: absolute;
    inset: 0;
  }
  .cover-img > :global(*) {
    width: 100%;
    height: 100% !important;
    aspect-ratio: auto !important;
    object-fit: cover;
    border: 0;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 35%, rgb(13 13 15 / 0.55) 65%, var(--bg));
    pointer-events: none;
  }
  .cover-text {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(32px, 6vh, 72px);
  }
  .cover-meta {
    color: var(--text);
  }
  .cover h1 {
    margin-top: 16px;
    font-size: clamp(2.75rem, 1rem + 6.5vw, 7.5rem);
    line-height: 0.95;
    max-width: 16ch;
  }
  .cover-sum {
    margin: 24px 0 0;
    max-width: 52ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  /* ---------- Thân bài kiểu tạp chí ---------- */
  .body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(64px, 9vw, 128px);
  }
  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    align-self: start;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .toc a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--text);
  }

  .part + .part,
  .part + .teacher {
    margin-top: clamp(72px, 10vw, 140px);
  }
  .part h2 {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .lead {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    line-height: 1.5;
    font-weight: 400;
    max-width: 44ch;
  }
  .prose:not(.lead) {
    color: var(--muted);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(48px, 7vw, 96px);
  }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
  }
  .step-flip .step-img {
    order: 2;
  }
  .step-flip {
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
  }
  .step-text {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .step-cap {
    margin: 10px 0 0;
    font-size: var(--fs-lead);
    font-family: var(--serif);
    line-height: 1.4;
  }

  .results {
    columns: 2;
    column-gap: clamp(14px, 2vw, 28px);
  }
  .results figure {
    break-inside: avoid;
    margin: 0 0 clamp(20px, 3vw, 36px);
  }
  .results figcaption {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .teacher {
    border-left: 1px solid var(--accent);
    padding: 8px 0 8px clamp(20px, 3vw, 36px);
    max-width: 60ch;
  }
  .teacher blockquote {
    margin: 16px 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
    line-height: 1.4;
  }
  .score {
    display: flex;
    gap: 14px;
    align-items: baseline;
    margin: 20px 0 0;
  }
  .score-n {
    font-family: var(--serif);
    font-size: 2.5rem;
    line-height: 1;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(80px, 10vw, 140px);
  }
  .pg {
    display: grid;
    gap: 8px;
    padding: 28px 24px 28px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .pg-next {
    text-align: right;
    padding: 28px 0 28px 24px;
    border-left: 1px solid var(--line);
  }
  .pg-title {
    font-family: var(--serif);
    font-size: var(--fs-h3);
    line-height: 1.15;
  }
  .pg:hover .pg-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .toc {
      position: static;
    }
  }
  @media (max-width: 700px) {
    .step,
    .step-flip {
      grid-template-columns: 1fr;
    }
    .step-flip .step-img {
      order: 0;
    }
    .results {
      columns: 1;
    }
  }
</style>
