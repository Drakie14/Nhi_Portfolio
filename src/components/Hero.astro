---
interface Props {
  name: string;
  tagline?: string;
  school?: string;
  schoolYear?: string;
  semester?: string;
}
const { name, tagline, school, schoolYear, semester } = Astro.props;

// Tên ngắn thì chữ càng lớn; tên dài tự thu nhỏ để không tràn
const len = name.trim().length;
const scale = len <= 5 ? 'xl' : len <= 12 ? 'l' : 'm';
---
<section class="hero" aria-labelledby="hero-ten">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-inner wrap">
    <p class="coords label" aria-label="Toạ độ Trường Đại học Kiến trúc TP.HCM">
      10.7769° N, 106.6953° E
    </p>

    <div class="title-block">
      <div class="measure">
        <!-- Đường kích thước ngang, đo bề rộng của tên -->
        <div class="dim-h" aria-hidden="true">
          <span class="tick tick-l"></span>
          <span class="dim-text label">{schoolYear ?? 'Kiến trúc · UAH'}</span>
          <span class="tick tick-r"></span>
        </div>

        <div class="name-row">
          <!-- Đường kích thước dọc, đo chiều cao chữ -->
          <div class="dim-v" aria-hidden="true">
            <span class="dim-line"></span>
            <span class="dim-text label">1:1</span>
          </div>
          <h1 id="hero-ten" class:list={['name', `name-${scale}`]}>{name}</h1>
        </div>
      </div>

      {tagline && <p class="tagline">{tagline}</p>}
    </div>

    <div class="hero-foot">
      <a class="scroll-cue label" href="#noi-bat">
        <span class="scroll-cue-line" aria-hidden="true"></span>
        Cuộn xuống
      </a>

      <dl class="stamp-box" aria-label="Khung tên bản vẽ">
        <div><dt>Người vẽ</dt><dd>{name}</dd></div>
        {school && <div><dt>Trường</dt><dd>{school}</dd></div>}
        {semester && <div><dt>Học kỳ</dt><dd>{semester}</dd></div>}
        <div class="half"><dt>Tỉ lệ</dt><dd>1:1</dd></div>
        <div class="half"><dt>Bản vẽ</dt><dd>01</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    margin-top: calc(var(--nav-h) * -1);
    padding-top: var(--nav-h);
    display: flex;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* Giấy bản vẽ: lưới nhỏ 24px, lưới lớn 120px, mờ dần ra mép */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
      linear-gradient(var(--grid-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
    background-size:
      120px 120px,
      120px 120px,
      24px 24px,
      24px 24px;
    background-position: -1px -1px;
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 40% 45%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 75% at 40% 45%, #000 30%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 32px;
    padding-block: clamp(28px, 5vh, 56px) clamp(24px, 4vh, 40px);
  }

  .coords {
    margin: 0;
    justify-self: end;
  }

  .title-block {
    align-self: center;
    justify-self: start;
    display: grid;
    width: fit-content;
    max-width: 100%;
  }

  .name-row {
    display: flex;
    align-items: stretch;
    gap: clamp(14px, 2vw, 28px);
  }

  .name {
    font-size: var(--fs-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.03em;
    padding-block: 0.12em 0.08em;
    overflow-wrap: anywhere;
  }

  .name-xl {
    font-size: clamp(7rem, 2rem + 26vw, 20rem);
  }
  .name-m {
    font-size: clamp(3rem, 1rem + 9vw, 9.5rem);
  }

  .tagline {
    margin: clamp(20px, 3vw, 36px) 0 0;
    padding-left: calc(clamp(14px, 2vw, 28px) + 21px);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 300;
    color: var(--muted);
    max-width: 40ch;
  }

  /* ----- Đường kích thước ----- */
  .measure {
    --indent: calc(clamp(14px, 2vw, 28px) + 21px);
    display: grid;
    width: fit-content;
    max-width: 100%;
  }
  .tick {
    position: absolute;
    top: 50%;
    width: 13px;
    height: 1px;
    background: var(--text);
    /* vạch chéo 45° ở hai đầu — quy ước trên bản vẽ kiến trúc */
    transform: rotate(-45deg);
  }

  .dim-h {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 36px;
    margin-bottom: 14px;
    margin-left: var(--indent);
    border-inline: 1px solid var(--line);
  }
  .dim-h::before,
  .dim-h::after {
    content: '';
    flex: 1 1 0;
    min-width: 28px;
    height: 1px;
    background: var(--muted);
  }
  .dim-h::before {
    transform-origin: 0 50%;
  }
  .dim-h::after {
    transform-origin: 100% 50%;
  }
  .tick-l {
    left: -7px;
  }
  .tick-r {
    right: -7px;
  }
  .dim-h .dim-text {
    color: var(--text);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .dim-h {
      height: auto;
      min-height: 36px;
      padding-block: 4px;
    }
    .dim-h::before,
    .dim-h::after {
      min-width: 16px;
    }
    .dim-h .dim-text {
      white-space: normal;
      text-align: center;
      letter-spacing: 0.08em;
    }
  }

  .dim-v {
    position: relative;
    width: 20px;
    flex: none;
    border-block: 1px solid var(--line);
  }
  .dim-v .dim-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--muted);
  }
  .dim-v .dim-line::before,
  .dim-v .dim-line::after {
    content: '';
    position: absolute;
    left: -6px;
    width: 13px;
    height: 1px;
    background: var(--text);
    transform: rotate(-45deg);
  }
  .dim-v .dim-line::before {
    top: 0;
  }
  .dim-v .dim-line::after {
    bottom: 0;
  }
  .dim-v .dim-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-90deg);
    background: var(--bg);
    padding-inline: 8px;
    color: var(--text);
  }

  /* ----- Chân hero: chỉ báo cuộn + khung tên ----- */
  .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    text-decoration: none;
    color: var(--text);
    padding-block: 4px;
  }
  .scroll-cue-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: var(--line);
    overflow: hidden;
  }
  .scroll-cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 18px;
    background: var(--accent);
  }

  .stamp-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(360px, 100%);
    margin: 0;
    border: 1px solid var(--line);
    background: rgb(13 13 15 / 0.85);
  }
  .stamp-box > div {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 92px 1fr;
    border-bottom: 1px solid var(--line);
  }
  .stamp-box > div:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .stamp-box > .half {
    grid-column: span 1;
    grid-template-columns: auto 1fr;
  }
  .stamp-box > .half + .half {
    border-left: 1px solid var(--line);
  }
  .stamp-box dt,
  .stamp-box dd {
    margin: 0;
    padding: 7px 10px;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
  }
  .stamp-box dt {
    color: var(--muted);
    text-transform: uppercase;
    border-right: 1px solid var(--line);
  }
  .stamp-box dd {
    color: var(--text);
  }

  /* ----- Một khoảnh khắc khi tải trang: đường kích thước tự vẽ ----- */
  @media (prefers-reduced-motion: no-preference) {
    .dim-h::before,
    .dim-h::after {
      animation: draw-x 1.1s var(--ease) 0.15s both;
    }
    .dim-v .dim-line {
      animation: draw-y 0.9s var(--ease) 0.15s both;
      transform-origin: 50% 0;
    }
    .dim-text,
    .tick,
    .dim-line::before,
    .dim-line::after {
      animation: fade 0.5s ease 1.05s both;
    }
    .name,
    .tagline {
      animation: rise 1.1s var(--ease) both;
    }
    .tagline {
      animation-delay: 0.55s;
    }
    .scroll-cue-line::after {
      animation: cue 2.4s var(--ease) 1.6s infinite;
    }
  }

  @keyframes draw-x {
    from { transform: scaleX(0); }
  }
  @keyframes draw-y {
    from { transform: scaleY(0); }
  }
  @keyframes fade {
    from { opacity: 0; }
  }
  /* chỉ trượt nhẹ, không làm mờ — để chữ hiện ngay (tốt cho tốc độ tải) */
  @keyframes rise {
    from { transform: translateY(0.12em); }
  }
  @keyframes cue {
    0% { transform: translateY(-18px); }
    60%, 100% { transform: translateY(56px); }
  }

  @media (max-width: 640px) {
    .hero-foot {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .stamp-box {
      width: 100%;
    }
    .coords {
      justify-self: start;
    }
  }
</style>
