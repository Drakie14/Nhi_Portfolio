---
import Stamp from './Stamp.astro';
import { NAV } from '../lib/nav';

interface Props {
  name: string;
}
const { name } = Astro.props;
---
<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a class="brand" href="/">
      <Stamp name={name} />
      <span class="brand-name">{name}<span class="visually-hidden"> — Trang chủ</span></span>
    </a>

    <nav class="links" aria-label="Điều hướng chính">
      <ul>
        {NAV.map((l) => (
          <li><a href={`/#${l.id}`}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
      <span class="visually-hidden">Mở menu</span>
      <span class="burger-lines" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="menu-top wrap">
    <span class="label">Menu</span>
    <button class="menu-close label" type="button" data-menu-close>Đóng</button>
  </div>
  <nav class="menu-links wrap" aria-label="Điều hướng chính">
    <ol>
      {NAV.map((l, i) => (
        <li>
          <a href={`/#${l.id}`} data-menu-link>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            {l.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: rgb(13 13 15 / 0.6);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .nav.is-scrolled {
    border-bottom-color: var(--line);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
  }
  .links ul {
    display: flex;
    gap: clamp(16px, 2.6vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    font-size: var(--fs-small);
    font-weight: 400;
    text-decoration: none;
    color: var(--muted);
    padding-block: 8px;
    transition: color 0.2s;
  }
  .links a:hover,
  .links a[aria-current='true'] {
    color: var(--text);
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    margin-right: -10px;
  }
  .burger-lines,
  .burger-lines::before {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--text);
    position: relative;
  }
  .burger-lines::before {
    content: '';
    position: absolute;
    top: 7px;
    width: 16px;
  }
  .burger-lines {
    transform: translateY(-4px);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--bg);
    background-image:
      linear-gradient(var(--grid-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
    background-size: 24px 24px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-top {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .menu-close {
    min-height: 44px;
    padding-inline: 4px;
    color: var(--text);
  }
  .menu-links ol {
    list-style: none;
    margin: 0;
    padding: 4vh 0;
  }
  .menu-links a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-block: 10px;
    font-family: var(--serif);
    font-size: clamp(2.75rem, 12vw, 4.5rem);
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .menu-links .label {
    min-width: 2.5em;
  }

  @media (max-width: 860px) {
    .links {
      display: none;
    }
    .burger {
      display: grid;
    }
  }
</style>
