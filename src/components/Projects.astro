---
import SectionHead from './SectionHead.astro';
import Media from './Media.astro';
import type { Project } from '../lib/data';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---
<section class="section" id="do-an" aria-labelledby="do-an-tieu-de">
  <div class="wrap">
    <SectionHead num="02" title="Đồ án" id="do-an" note={`${projects.length} đồ án`} />

    {
      projects.length === 0 ? (
        <p>Chưa có đồ án nào. Đồ án đầu tiên sẽ xuất hiện ở đây.</p>
      ) : (
        <ul class="projects">
          {projects.map((p, i) => (
            <li class:list={['p-item', { 'p-lead': i === 0 }]}>
              <a class="p-link" href={`/do-an/${p.id}/`}>
                <span class="p-media" data-reveal>
                  <Media
                    src={p.data.cover}
                    alt={p.data.title}
                    key={p.id}
                    ratio={i === 0 ? '16/9' : '4/3'}
                    cover
                    phText="Đồ án sắp ra mắt"
                    sizes={i === 0 ? '(min-width: 1440px) 1330px, 100vw' : '(min-width: 900px) 50vw, 100vw'}
                    widths={i === 0 ? [768, 1080, 1440, 1920] : [480, 768, 1080]}
                  />
                </span>
                <span class="p-text">
                  <span class="p-meta label">
                    {[p.data.subject, p.data.semester].filter(Boolean).join(' · ')}
                  </span>
                  <span class="p-title">{p.data.title}</span>
                  {p.data.summary && <span class="p-sum">{p.data.summary}</span>}
                  <span class="p-cta label">Đọc đồ án</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(48px, 6vw, 88px) clamp(20px, 3vw, 44px);
  }
  .p-lead {
    grid-column: 1 / -1;
  }
  .p-link {
    display: grid;
    gap: 20px;
    text-decoration: none;
  }
  .p-lead .p-link {
    grid-template-columns: 1fr;
  }
  .p-media {
    display: block;
    overflow: hidden;
  }
  .p-media :global(img) {
    transition:
      transform 1.2s var(--ease),
      filter 0.6s;
    filter: brightness(0.88);
  }
  .p-link:hover .p-media :global(img) {
    transform: scale(1.025);
    filter: none;
  }
  .p-text {
    display: grid;
    gap: 10px;
    max-width: 62ch;
  }
  .p-lead .p-text {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(20px, 3vw, 44px);
    max-width: none;
    align-items: start;
  }
  .p-lead .p-meta,
  .p-lead .p-title {
    grid-column: 1;
  }
  .p-lead .p-sum {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
  }
  .p-lead .p-cta {
    grid-column: 2;
  }
  .p-title {
    font-family: var(--serif);
    font-size: var(--fs-h3);
    line-height: 1.1;
  }
  .p-lead .p-title {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
  }
  .p-sum {
    color: var(--muted);
  }
  .p-cta {
    color: var(--text);
    justify-self: start;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }
  .p-link:hover .p-cta {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .projects {
      grid-template-columns: 1fr;
    }
    .p-lead .p-text {
      grid-template-columns: 1fr;
    }
    .p-lead .p-sum,
    .p-lead .p-cta {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
