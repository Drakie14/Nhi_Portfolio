---
import { render } from 'astro:content';
import SectionHead from './SectionHead.astro';
import Media from './Media.astro';
import { getSettings } from '../lib/data';

interface Props {
  stats: { n: number; label: string }[];
}
const { stats } = Astro.props;
const settings = await getSettings();
const s = settings.data;
const { Content } = await render(settings);
---
<section class="section" id="ve-toi" aria-labelledby="ve-toi-tieu-de">
  <div class="wrap">
    <SectionHead num="04" title="Về tôi" id="ve-toi" />

    <div class="about">
      <figure class="portrait" data-reveal>
        <Media
          src={s.avatar}
          alt={`Ảnh chân dung của ${s.name}`}
          ratio="4/5"
          cover
          phText="Ảnh đại diện sắp ra mắt"
          sizes="(min-width: 900px) 34vw, 100vw"
          widths={[480, 768, 1080]}
        />
      </figure>

      <div class="about-text">
        <div class="bio prose">
          <Content />
        </div>

        <dl class="facts">
          {s.school && (
            <div>
              <dt class="label">Trường</dt>
              <dd>{s.school}</dd>
            </div>
          )}
          {s.schoolYear && (
            <div>
              <dt class="label">Năm học</dt>
              <dd>{s.schoolYear}</dd>
            </div>
          )}
        </dl>

        {s.skills.length > 0 && (
          <div class="skills">
            <h3 class="label">Kỹ năng & công cụ</h3>
            <ul>
              {s.skills.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          </div>
        )}

        <ul class="stats" data-counters>
          {stats.map((st) => (
            <li>
              <span class="stat-n" data-count={st.n}>{st.n}</span>
              <span class="label">{st.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .portrait {
    margin: 0;
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  .portrait :global(img) {
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.8s var(--ease);
  }
  .portrait:hover :global(img) {
    filter: none;
  }
  .bio {
    font-family: var(--serif);
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
    line-height: 1.4;
    font-weight: 400;
    max-width: 34ch;
  }
  .bio :global(p + p) {
    font-family: var(--sans);
    font-size: var(--fs-body);
    font-weight: 300;
    line-height: 1.75;
    color: var(--muted);
    max-width: 60ch;
  }
  .facts {
    display: grid;
    gap: 0;
    margin: clamp(32px, 4vw, 48px) 0 0;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    padding-top: 0.3em;
  }
  .facts dd {
    margin: 0;
  }
  .skills {
    margin-top: 32px;
  }
  .skills h3 {
    font-family: var(--mono);
    font-weight: 400;
    margin-bottom: 14px;
  }
  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skills li {
    padding: 5px 12px;
    border: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .stats li {
    display: grid;
    gap: 6px;
    padding: 20px 16px 0 0;
  }
  .stats li + li {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }
  .stat-n {
    font-family: var(--serif);
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    line-height: 0.9;
    font-variant-numeric: lining-nums tabular-nums;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: static;
      max-width: 420px;
    }
  }
</style>

<script>
  // Các con số tự đếm khi cuộn tới (HTML đã có số cuối cùng sẵn)
  const box = document.querySelector<HTMLElement>('[data-counters]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (box && !reduce && 'IntersectionObserver' in window) {
    const els = [...box.querySelectorAll<HTMLElement>('[data-count]')];
    const run = () => {
      const t0 = performance.now();
      const dur = 1400;
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - k, 3);
        els.forEach((el) => (el.textContent = String(Math.round(Number(el.dataset.count) * e))));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((en) => en.isIntersecting)) {
          io.disconnect();
          run();
        }
      },
      { threshold: 0.6 },
    );
    io.observe(box);
  }
</script>
